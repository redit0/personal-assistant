<Application x:Class="Assistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Personal Assistant"
                        IconSource="/assistant.ico"
                        NoLeftClickDelay="True"
                        MenuActivation="RightClick"
                        TrayLeftMouseUp="OnTrayLeftClick"
                        TrayBalloonTipClicked="OnBalloonClicked">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Today" Click="OnOpenToday" />
                    <MenuItem Header="Items" Click="OnOpenItems" FontWeight="Bold" />
                    <MenuItem Header="Chat" Click="OnOpenChat" />
                    <MenuItem Header="Activity" Click="OnOpenActivity" />
                    <MenuItem Header="Settings" Click="OnOpenSettings" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
