<Window x:Class="Assistant.App.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve tool call?"
        Icon="/assistant.ico"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Subheading" Margin="0,4,0,0" Foreground="#5F6B7A" TextWrapping="Wrap" />

        <Border x:Name="ReasonBox" Margin="0,12,0,0" Padding="10,8" Background="#FFF6DB" CornerRadius="6" Visibility="Collapsed">
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" />
        </Border>

        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Arguments" />
        <TextBox x:Name="ArgumentsText"
                 IsReadOnly="True"
                 FontFamily="Cascadia Code, Consolas"
                 FontSize="12"
                 MaxHeight="300"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="6" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="Countdown" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#5F6B7A" />
            <Button x:Name="ApproveButton" DockPanel.Dock="Right" Content="Approve" MinWidth="90" Padding="12,5" Margin="8,0,0,0" Click="OnApprove" />
            <Button x:Name="DenyButton" DockPanel.Dock="Right" Content="Deny" MinWidth="90" Padding="12,5" Click="OnDeny" />
        </DockPanel>
    </StackPanel>
</Window>
