<Window x:Class="Assistant.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:web="clr-namespace:Assistant.Web;assembly=Assistant.Web"
        Title="Personal Assistant"
        Icon="/assistant.ico"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" BlazorWebViewInitializing="OnWebViewInitializing">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type web:Routes}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
