    private const string GitHubId = "github";
    private const string JiraId = "jira";
    private const string BitbucketId = "bitbucket";
    private const string AzureDevOpsId = "azuredevops";

    private UserSettings _settings = new();
    private IReadOnlyList<ConnectorStatus> _statuses = [];
    private string? _githubToken;
    private string? _jiraToken;
    private string? _bitbucketToken;
    private string? _saved;
    private bool _adoBusy;
    private string? _adoMessage;
    private string? _newTenantId;
    private string? _newTenantLabel;
    private string? _newTokenOrg;
    private string? _newTokenValue;
    private bool _adoError;

    protected override void OnInitialized()
    {
        _settings = SettingsStore.Current;
        _mutedText = string.Join('\n', _settings.Triage.MutedSenders);
        _statuses = Sync.GetStatuses();
        Sync.StatusChanged += OnStatusChanged;
    }

    private void OnStatusChanged() => InvokeAsync(() =>
    {
        _statuses = Sync.GetStatuses();
        StateHasChanged();
    });

    private ConnectorStatus? Status(string id) => _statuses.FirstOrDefault(s => s.Id == id);

    private bool HasSecret(string name) => !string.IsNullOrEmpty(Secrets.Get(name));

    private void SaveSecret(string name, ref string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            Secrets.Set(name, value.Trim());
        }

        value = null;
    }

    private void RemoveSecret(string name)
    {
        Secrets.Delete(name);
        Refresh("Token removed");
    }

    private void SaveGitHub()
    {
        SaveSecret(SecretNames.GitHubToken, ref _githubToken);
        SettingsStore.Update(s => s.GitHub = _settings.GitHub);
        Sync.RequestSync(GitHubId);
        Refresh("GitHub saved");
    }

    private void SaveAtlassian()
    {
        SaveSecret(SecretNames.JiraApiToken, ref _jiraToken);
        SaveSecret(SecretNames.BitbucketApiToken, ref _bitbucketToken);
        _settings.Atlassian.JiraSiteUrl = _settings.Atlassian.JiraSiteUrl?.Trim().TrimEnd('/');
        SettingsStore.Update(s => s.Atlassian = _settings.Atlassian);
        Sync.RequestSync(JiraId);
        Sync.RequestSync(BitbucketId);
        Refresh("Atlassian saved");
    }

    private void SaveAzureDevOps()
    {
        // Only copy what this card edits. Discovery may have added organizations in the background.
        var edited = _settings.AzureDevOps;
        SettingsStore.Update(s =>
        {
            s.AzureDevOps.Enabled = edited.Enabled;
            s.AzureDevOps.WatchNewOrganizations = edited.WatchNewOrganizations;
            s.AzureDevOps.IntervalMinutes = edited.IntervalMinutes;
            foreach (var (org, watched) in edited.Organizations.Where(o => s.AzureDevOps.Organizations.ContainsKey(o.Key)))
            {
                s.AzureDevOps.Organizations[org] = watched;
            }
        });
        Sync.RequestSync(AzureDevOpsId);
        Refresh("Azure DevOps saved");
    }

    private void SetOrganization(string org, bool watched)
    {
        _settings.AzureDevOps.Organizations[org] = watched;
        SaveAzureDevOps();
    }

    private async Task ConnectAzureDevOpsAsync()
    {
        await RunAdoAsync(async () =>
        {
            await MicrosoftAuth.ConsentAsync(AzureDevOpsConnector.Scopes);
            return "Connected. Click Find organizations next.";
        });
    }

    private async Task DiscoverAsync()
    {
        await RunAdoAsync(async () =>
        {
            var result = await AzureDevOps.RefreshOrganizationsAsync(CancellationToken.None);
            _settings = SettingsStore.Current;
            var summary = result.Found == 0 ? "No organizations found." : $"Found {result.Found} organization{(result.Found == 1 ? "" : "s")}.";
            if (result.Errors.Count > 0)
            {
                _adoError = true;
                throw new InvalidOperationException(summary + " " + string.Join(" ", result.Errors));
            }

            return summary;
        });
    }

    private void AddTenant()
    {
        var tenantId = _newTenantId?.Trim();
        if (string.IsNullOrEmpty(tenantId))
        {
            return;
        }

        if (!AzureCliToken.IsValidTenant(tenantId))
        {
            _adoMessage = $"'{tenantId}' isn't a tenant ID or domain.";
            _adoError = true;
            return;
        }

        SettingsStore.Update(s =>
        {
            if (!s.AzureDevOps.Tenants.Any(t => string.Equals(t.TenantId, tenantId, StringComparison.OrdinalIgnoreCase)))
            {
                s.AzureDevOps.Tenants.Add(new AzureDevOpsTenant
                {
                    TenantId = tenantId,
                    Label = string.IsNullOrWhiteSpace(_newTenantLabel) ? null : _newTenantLabel.Trim(),
                });
            }
        });

        _adoMessage = $"Added. Run az login --tenant {tenantId} in a terminal, then click Find organizations.";
        _adoError = false;
        _newTenantId = null;
        _newTenantLabel = null;
        _settings = SettingsStore.Current;
    }

    private void RemoveTenant(string tenantId)
    {
        var source = AzureDevOpsSettings.TenantSource(tenantId);
        SettingsStore.Update(s =>
        {
            s.AzureDevOps.Tenants.RemoveAll(t => string.Equals(t.TenantId, tenantId, StringComparison.OrdinalIgnoreCase));
            foreach (var org in s.AzureDevOps.OrganizationSources.Where(o => o.Value == source).Select(o => o.Key).ToList())
            {
                s.AzureDevOps.OrganizationSources.Remove(org);
                s.AzureDevOps.Organizations.Remove(org);
            }
        });
        Refresh("Tenant removed");
    }

    private void AddTokenOrganization()
    {
        var org = _newTokenOrg?.Trim().Trim('/');
        if (string.IsNullOrEmpty(org) || string.IsNullOrWhiteSpace(_newTokenValue))
        {
            return;
        }

        // Accept a pasted URL like https://dev.azure.com/contoso.
        if (Uri.TryCreate(org, UriKind.Absolute, out var url))
        {
            org = url.AbsolutePath.Trim('/').Split('/')[0];
        }

        Secrets.Set(SecretNames.AzureDevOpsToken(org), _newTokenValue.Trim());
        SettingsStore.Update(s =>
        {
            s.AzureDevOps.Organizations[org] = true;
            s.AzureDevOps.OrganizationSources[org] = AzureDevOpsSettings.TokenSource;
        });

        _newTokenOrg = null;
        _newTokenValue = null;
        Sync.RequestSync(AzureDevOpsId);
        Refresh($"{org} added");
    }

    private void RemoveTokenOrganization(string org)
    {
        Secrets.Delete(SecretNames.AzureDevOpsToken(org));
        SettingsStore.Update(s =>
        {
            s.AzureDevOps.Organizations.Remove(org);
            s.AzureDevOps.OrganizationSources.Remove(org);
        });
        Refresh($"{org} removed");
    }

    private void CopyLogin(string tenantId)
    {
        Clipboard.SetText($"az login --tenant {tenantId}");
        Refresh("Command copied");
    }

    private string SourceLabel(string source)
    {
        if (source == AzureDevOpsSettings.TokenSource)
        {
            return "access token";
        }

        if (source.StartsWith("tenant:", StringComparison.Ordinal))
        {
            var id = source["tenant:".Length..];
            return _settings.AzureDevOps.Tenants.FirstOrDefault(t => t.TenantId == id)?.Label ?? id;
        }

        return "home tenant";
    }

    private async Task RunAdoAsync(Func<Task<string>> action)
    {
        _adoBusy = true;
        _adoMessage = null;
        try
        {
            _adoMessage = await action();
            _adoError = false;
        }
        catch (Exception ex)
        {
            _adoMessage = ex.Message;
            _adoError = true;
        }
        finally
        {
            _adoBusy = false;
        }
    }

    private async void Refresh(string message)
    {
        _settings = SettingsStore.Current;
        _statuses = Sync.GetStatuses();
        _saved = message;
        StateHasChanged();
        await Task.Delay(2500);
        if (_saved == message)
        {
            _saved = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Sync.StatusChanged -= OnStatusChanged;
}
